; ---
; title: Spule erfassen
; description: "{% for w in global.spool_net_weight %}{% set i = loop.index0 %}{% if tools[i] %}{{ ' · ' if i }}T{{ i }}: {{ global.spool_remaining[i] | round ~ ' von ' ~ w ~ ' g' if w else 'offen' }}{% endif %}{% endfor %}"
; icon: mdi-scale
; page: [start, job]
; order: 28
; enabled: "{{ state.status in ['idle', 'paused'] }}"
; hint: Nur im Leerlauf oder bei pausiertem Druck
; ---
; set-spool-size
; Records or corrects the spool mounted on a tool: nominal net weight and what
; is left on it. The same questions the filament load asks at its feed prompt - one call
; to spool/confirm.g without A1, so the tool's current values are preselected:
; a dropdown of the common sizes ("Other..." for a free value in grams), the spool body
; from the spool catalog (macro edit-spool-catalog, gives the empty-spool weight), then the
; weight on a scale - the tare is subtracted automatically. With a material.g the size
; dropdown lists the profile's own spool sizes instead.
; Persisted per tool in sys/generated/spool<tool>.g together with the filament's
; density, which the consumption tracker (spool/track.g) needs. Cancelling the first
; prompt keeps everything. Use it when a spool is swapped without a filament change
; (same material, new spool) or to correct the tracked remaining weight.
; Allowed while a print is paused (a spool change), never while it prints.
; A flow of the CHX 350 UI (CLAUDE.md, "Flows in the CHX 350 UI"), started without
; parameters - the tool is then asked by lib/ask-tool.g.

if job.file.fileName != null && state.status != "paused"
  echo "Error: a print job is running - abort!"
  M99

; which tool: T<n> when called with it, else asked when more than one tool has an
; extruder (with T0 and T1 in two motion systems DWC's current tool is only that of its
; own motion system); lib/ask-tool.g hands it back in global.result, -1 = cancelled
var tool = 0
if exists(param.T)
  set var.tool = (param.T == 1) ? 1 : 0
else
  M98 P"0:/sys/meltingplot/lib/ask-tool.g" S"Die Spule welches Druckkopfs erfassen?"
  set var.tool = global.result
  if var.tool < 0
    echo "Error: spool entry cancelled"
    M99
M98 P"0:/sys/meltingplot/spool/confirm.g" T{var.tool}

;; {% if state.messageBox %}**{{ state.messageBox.message }}**{% endif %}
;;
;; Der Verbrauch wird von diesem Stand an mitgezählt, sobald das Material eine Dichte hat
;; (material.g des Filamentprofils).
M291 R"Spule erfasst" P{"T" ^ var.tool ^ ": " ^ floor(global.spool_remaining[var.tool]) ^ " g von " ^ global.spool_net_weight[var.tool] ^ " g" ^ (global.spool_density[var.tool] > 0 ? "" : " (ohne Dichte, nicht gezählt)")} S2
M400 ; sbc specific

; the flow reached its goal - the CHX 350 UI reports it completed (CLAUDE.md, "Completion")
echo ";; Completed"
