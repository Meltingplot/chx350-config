; description: "{{ ((global.operating_time_base + state.upTime) / 3600) | round }} Betriebsstunden{% if global.self_test_failed[0] or global.self_test_failed[1] %} · Fehler: {{ global.self_test_failed[0] }}{{ global.self_test_failed[1] }}{% endif %}"
