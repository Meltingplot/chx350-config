; ---
; title: Selbsttest
; description: "Betriebsstunden: {{ ((global.operating_time_base + state.upTime) / 3600) | round }}{% if global.self_test_failed[0] or global.self_test_failed[1] %} · Fehler: {{ global.self_test_failed[0] }}{{ global.self_test_failed[1] }}{% endif %}"
; icon: mdi-clipboard-pulse-outline
; page: service
; order: 5
; enabled: "{{ state.status == 'idle' and state.upTime >= global.ota_pending_until }}"
; hint: Nur im Leerlauf, nicht während eines Updates
; ---
; maintenance/self-test
; The self-test (CLAUDE.md, "Power-on self-test"), an ordinary flow. It runs what is due
; (self-test/tick.g), without a prompt: nobody has to be at the machine. Started with nothing due, it
; asks which tier to run, for instance after a repair: a failed tier is otherwise not due for 30 min.
; self-test/tick.g starts it by itself with A1, on the HTTP channel (M98.3): after every boot and every
; self_test_interval hours of operation. The UI then follows it as after a browser reload: the panel
; comes with the first documented box and goes after the last, with no result and no close button.
; So with A1 it shows the outcome itself. Never as a blocking prompt: that would hold the HTTP channel,
; console and jog included, until someone answers. A failed tier runs again every 30 min on an idle
; machine, which shows the box again. In between, the tile's description names the findings and
; start.g refuses a job with them. With A1 it writes neither the completion line nor Error: nobody
; waits for them, and the UI reads the messages of every channel, so they would land in the run of a
; flow started on the panel meanwhile. report.g has put the findings in the event log.
; With A1 it runs the quick tier only, which neither heats nor moves. A test that does never starts by
; itself: the weekly tier comes with the next job (start.g) or by hand, and the monthly check, a flow
; of its own that needs the operator, only by hand.

if job.file.fileName != null
  echo "Error: a print job is running - abort!"
  M99

set global.self_test_wanted = false
var auto = exists(param.A)
; By hand a quick tier with a finding runs again at once. It is not due for 30 min after a failure, and
; a due weekly tier skips the question below, so the flow could only repeat the old finding (2026-11-09).
var quick = global.self_test_due[0] || (!var.auto && global.self_test_failed[0] != "")
var weekly = global.self_test_due[1] && !var.auto
var asked = false
var problem = ""

; An update comes first, also over a run by hand (self-test/check-update.g). The tick has looked
; already, this covers the moment since.
M98 P"0:/sys/meltingplot/self-test/check-update.g"
if global.self_test_update_running
  if !var.auto
    echo "Error: an update is running - try again when its message has gone"
  M99

; nobody at the machine, and a run by hand came first
if var.auto && !var.quick
  M99

if !var.quick && !var.weekly
  M291 R"Selbsttest" P"Welche Stufe? Kurztest: einige Sekunden. Wochentest: heizt und prüft Lüfter, bis 4 min. Monatsprüfung: mit Ihnen, etwa 15 min." S4 K{"Kurztest","Wochentest","Monatsprüfung"} F0 J2
  if result != 0             ; J2 leaves input undefined - result must be tested right here
    echo "Error: self-test cancelled"
    M99
  var tier = input
  ; It reports errors itself. A pass ends with the machine halted and its completion sent by
  ; self-test/estop-fired.g. It only comes back passed for a firing it found already recorded.
  if var.tier == 2
    var monthly_before = global.self_test_done[2]
    M98 P"0:/macros/meltingplot/maintenance/monthly-check" C0
    if global.self_test_done[2] != var.monthly_before
      echo ";; Completed"
    M99
  set var.quick = var.tier == 0
  set var.weekly = var.tier == 1
  set var.asked = true

if var.quick
  M98 P"0:/sys/meltingplot/self-test/check-quick.g"

; A machine that is not fit is not heated up on top, unless the operator asked for exactly that
if (var.quick || !var.asked) && global.self_test_failed[0] != ""
  set var.problem = global.self_test_failed[0]

if var.weekly && var.problem == ""
  M98 P"0:/sys/meltingplot/self-test/check-weekly-ready.g"
  ; A warm machine runs the test in automatic mode only (check-weekly-ready.g), and by hand the
  ; operator is here for the door check that brings it. Never with A1: weekly is never set then.
  if !global.self_test_weekly_ready && ("" ^ global.machine_mode) != "automatic"
    M98 P"0:/sys/meltingplot/ce-declaration/operating-mode/wait-automatic.g"
    M98 P"0:/sys/meltingplot/self-test/check-weekly-ready.g"
  if global.self_test_weekly_ready
    M98 P"0:/sys/meltingplot/self-test/check-weekly.g"
    if global.result != 0
      set var.problem = "Wochentest abgebrochen: Tür, Heizung oder Druckauftrag haben übernommen. Er läuft später erneut."
    elif global.self_test_failed[1] != ""
      set var.problem = global.self_test_failed[1]
  elif !var.quick
    ; nothing ran, so nothing passed
    set var.problem = "Wochentest nicht durchgeführt: Türen zu, Heizungen und Bauteillüfter aus, Bett höchstens " ^ (heat.heaters[0].max - 9) ^ " °C, Hotend höchstens " ^ (heat.heaters[1].max - 15) ^ " °C."

; A weekly finding of an earlier run still stands and start.g refuses jobs with it: this run has not
; cleared it. Only an operator who asked for one tier gets that tier's result alone.
if var.problem == "" && !var.asked && global.self_test_failed[1] != ""
  set var.problem = global.self_test_failed[1]

if var.problem != ""
  if var.auto
    M291 R"Ergebnis Selbsttest" P{var.problem} S1 T60
  else
    echo "Error: " ^ var.problem
  M99

if var.auto
  M291 R"Selbsttest bestanden" P"Der Selbsttest ist bestanden." S1 T5
  M99

; the flow reached its goal - the CHX 350 UI reports it completed (CLAUDE.md, "Completion")
echo ";; Completed"
