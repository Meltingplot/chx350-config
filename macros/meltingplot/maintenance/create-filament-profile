; create-filament-profile
; Creates a new filament profile under 0:/filaments/<name>/ from scratch:
;   temps.g            - active/standby/unload temperature. Canonical temperature store,
;                        read by filament_load.g/filament_unload.g (RRF cannot read values
;                        back out of the machine-generated load.g/unload.g).
;   config-override.g  - material parameters that do NOT depend on the nozzle (M143 ...)
;   nozzle-<d>.g       - parameters of the installed nozzle: max volumetric flow rate,
;                        pressure advance, firmware retraction, heater feedforward.
;                        Selected automatically by the generated config.g through
;                        global.nozzle_diameter of the current tool.
;   config.g/load.g/unload.g - machine-owned, written by regenerate_filament_config.g
; A profile describes one MATERIAL, not one material/nozzle combination. Running it again
; for a profile that already exists adds the parameter set of the currently installed
; nozzle (macro set-nozzle-diameter), so one PLA profile can serve 0.4, 0.6 and 0.8 mm.
; The nozzle half of that is create_nozzle_config.g, shared with the filament-load path:
; selecting a profile whose nozzle values are missing offers the same questions there.
; For profiles that are broken rather than incomplete (e.g. created in DWC) use macro
; repair-filament-profile.

var tool = state.currentTool >= 0 ? state.currentTool : 0
; two decimals of fixed width - see globals: the raw float must never build a file name.
; sformat.g returns the key in global.result - read it straight away
M98 P"0:/sys/meltingplot/sformat.g" F{global.nozzle_diameter[var.tool]} D2 W0
var nozzle = global.result

M291 R"New filament profile" P"Name of the filament profile (becomes the directory name under /filaments):" S7 L1 H40 J2
if result != 0
  M99
var name = input
if var.name == ""
  M99

var dir = "0:/filaments/" ^ var.name ^ "/"
var nfile = var.dir ^ "nozzle-" ^ var.nozzle ^ ".g"
var addNozzleOnly = false

; an existing profile is extended by the current nozzle instead of being overwritten
if fileexists(var.dir ^ "temps.g") || fileexists(var.dir ^ "config-override.g") || fileexists(var.dir ^ "config.g")
  if !fileexists(var.dir ^ "temps.g")
    M291 R"New filament profile" P{"Profile '" ^ var.name ^ "' exists but is incomplete - run macro repair-filament-profile first."} S1 T0
    M99
  if fileexists(var.nfile)
    M291 R"New filament profile" P{"Profile '" ^ var.name ^ "' already has values for the " ^ var.nozzle ^ "mm nozzle - edit them in DWC."} S1 T0
    M99
  ; the profile exists and only lacks this nozzle - create_nozzle_config.g below asks
  ; whether to add it ("Not now" is the way out), so no second confirmation here
  set var.addNozzleOnly = true

; --- temperatures (temps.g) ---
var active = 220
var standby = 160
var unload = 220

if !var.addNozzleOnly
  ; a leftover empty directory makes M470 fail - harmless, the temps.g write below is the
  ; real check whether the profile directory is usable
  M470 P{"0:/filaments/" ^ var.name}
  M291 R{"New profile: " ^ var.name} P"Active (extrusion) temperature:" S5 L150 H450 F220 J2
  if result != 0
    M99
  set var.active = input
  M291 R{"New profile: " ^ var.name} P"Standby temperature:" S5 L0 H300 F160 J2
  if result != 0
    M99
  set var.standby = input
  M291 R{"New profile: " ^ var.name} P"Unload temperature (usually the active temperature):" S5 L150 H450 F{var.active} J2
  if result != 0
    M99
  set var.unload = input

  echo >{var.dir ^ "temps.g"} "; " ^ var.name ^ " - temperatures (user-editable, used by filament_load.g/filament_unload.g)"
  echo >>{var.dir ^ "temps.g"} "set global.filament_temp_active = " ^ var.active
  echo >>{var.dir ^ "temps.g"} "set global.filament_temp_standby = " ^ var.standby
  echo >>{var.dir ^ "temps.g"} "set global.filament_temp_unload = " ^ var.unload

  if !fileexists(var.dir ^ "temps.g")
    M291 R"New filament profile" P{"Could not write to 0:/filaments/" ^ var.name ^ "/ - invalid profile name?"} S1 T0
    M99

; --- material parameters, independent of the nozzle (config-override.g) ---
if !var.addNozzleOnly
  var maxtemp = var.active + 25 > 300 ? var.active + 25 : 300
  M291 R{"Profile: " ^ var.name} P"Hotend temperature limit (M143) for this material:" S5 L{var.active} H450 F{var.maxtemp} J2
  if result == 0                 ; cancelling keeps the default rather than dropping out
    set var.maxtemp = input
  echo >{var.dir ^ "config-override.g"} "; " ^ var.name ^ " - user customizations that do NOT depend on the nozzle"
  echo >>{var.dir ^ "config-override.g"} "; nozzle-specific values (flow rate, M572, M207, M309) live in nozzle-<diameter>.g"
  echo >>{var.dir ^ "config-override.g"} "M143 H1 S" ^ var.maxtemp ^ "     ; hotend temperature limit for this material"

; --- nozzle-specific parameters (nozzle-<diameter>.g) ---
; shared with the filament-load path (confirm_nozzle_diameter.g) and with macro
; set-nozzle-diameter: create_nozzle_config.g asks whether to enter the values or write
; defaults and writes the file, so every way of adding a nozzle to a profile asks the
; same questions and produces the same file.
; It hands the outcome back in global.result - read it straight away
M98 P"0:/sys/meltingplot/create_nozzle_config.g" S{var.name} T{var.tool}
var nozzleWritten = (global.result == 0)

; write the machine-owned config.g/load.g/unload.g
M98 P"0:/sys/meltingplot/regenerate_filament_config.g" S{var.name}

if var.nozzleWritten
  M291 R"New filament profile" P{"'" ^ var.name ^ "' ready for the " ^ var.nozzle ^ "mm nozzle. Load it via DWC (Filaments), then run calibrate_e_steps / calibrate_pa."} S1 T0
else
  M291 R"New filament profile" P{"'" ^ var.name ^ "' has no values for the " ^ var.nozzle ^ "mm nozzle yet - run this macro again to add them."} S1 T0
M400 ; sbc specific
