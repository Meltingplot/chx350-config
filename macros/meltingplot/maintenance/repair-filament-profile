; repair-filament-profile
; Repairs a filament profile that is missing the standard machine-owned files
; (typically a profile freshly created in DWC). Run this after the daemon.g watchdog
; reported a broken profile and force-unloaded the filament.
; config.g, load.g and unload.g are machine-owned and regenerated by
; regenerate_filament_config.g; existing config.g user content is moved to
; config-override.g. load.g/unload.g need the per-material temperatures, which
; live in temps.g (RRF cannot read them back out of existing G-code files) -
; if temps.g is missing the operator is prompted and it is written here.

; determine the profile name: currently loaded filament, else the profile the
; watchdog captured before the forced unload, else ask the operator
var name = move.extruders[0].filament
if var.name == ""
  set var.name = global.filament_broken_profile
if var.name == ""
  M291 R"Repair filament profile" P"Enter the exact filament profile name (directory under /filaments):" S7 L1 H40 J2
  if result != 0
    M99
  set var.name = input
if var.name == ""
  M99

; keyword arguments are limited to 255 chars - keep the condition short via a prefix var
var dir = "0:/filaments/" ^ var.name ^ "/"
if !fileexists(var.dir ^ "load.g") && !fileexists(var.dir ^ "unload.g") && !fileexists(var.dir ^ "config.g") && !fileexists(var.dir ^ "config-override.g") && !fileexists(var.dir ^ "temps.g")
  M291 R"Repair filament profile" P{"Profile '" ^ var.name ^ "' not found under 0:/filaments/ - create it in DWC first."} S1 T0
  M99

M291 R"Repair filament profile" P{"Repair profile '" ^ var.name ^ "'? config.g, load.g and unload.g will be regenerated (existing config.g content is moved to config-override.g)."} S4 K{"Repair","Cancel"} F0
if input != 0
  M99

; temps.g is the canonical temperature store the generated load.g/unload.g read.
; Prompt for it when missing; when present, offer to keep or re-enter.
var write_temps = true
if fileexists("0:/filaments/" ^ var.name ^ "/temps.g")
  M291 R"Repair filament profile" P"temps.g already exists. Keep the stored temperatures or re-enter them?" S4 K{"Keep","Re-enter"} F0
  if input == 0
    set var.write_temps = false

if var.write_temps
  var active = 215
  if state.currentTool >= 0 && tools[state.currentTool].active[0] > 0
    set var.active = floor(tools[state.currentTool].active[0])
  M291 R"Repair filament profile" P"Active (extrusion) temperature:" S5 L150 H400 F{var.active} J2
  if result != 0
    M99
  set var.active = input
  M291 R"Repair filament profile" P"Standby temperature:" S5 L0 H300 F160 J2
  if result != 0
    M99
  var standby = input
  M291 R"Repair filament profile" P"Unload temperature (usually the active temperature):" S5 L150 H400 F{var.active} J2
  if result != 0
    M99
  var unload = input
  echo >{"0:/filaments/" ^ var.name ^ "/temps.g"} "; " ^ var.name ^ " - temperatures (user-editable, used by filament_load.g/filament_unload.g)"
  echo >>{"0:/filaments/" ^ var.name ^ "/temps.g"} "set global.filament_temp_active = " ^ var.active
  echo >>{"0:/filaments/" ^ var.name ^ "/temps.g"} "set global.filament_temp_standby = " ^ var.standby
  echo >>{"0:/filaments/" ^ var.name ^ "/temps.g"} "set global.filament_temp_unload = " ^ var.unload

M98 P"0:/sys/meltingplot/regenerate_filament_config.g" S{var.name}

set global.filament_broken_profile = ""
M291 R"Repair filament profile" P{"Profile '" ^ var.name ^ "' repaired. Load the filament again via DWC (Filaments -> Load)."} S1 T0
M400 ; sbc specific
