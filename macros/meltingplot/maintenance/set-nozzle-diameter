; set-nozzle-diameter
; Records which nozzle is installed after a nozzle change. This is the same step the
; filament load runs at its feed prompt - one call to confirm_nozzle_diameter.g, nothing
; else: it asks with choice buttons (configured diameter preselected, "Other..." for a
; free value), persists a changed value per tool in sys/meltingplot/nozzle<tool>.g via
; store_nozzle_diameter.g, offers filaments/<name>/nozzle-<key>.g when the loaded profile
; has none for the diameter (create_nozzle_config.g) and applies it with
; load_nozzle_config.g. Cancelling keeps the configured value. The nozzle belongs to the
; tool, not to the filament: the diameter selects, for every profile, the nozzle file
; and the calibration results (config-auto-pa-<key>.g, -nle-, -esteps-), <key> being the
; diameter with two decimals: 0.40, 1.20.
; Allowed while a print is paused (a nozzle swap after a clog), never while it prints.

if job.file.fileName != null && state.status != "paused"
  echo "Error: a print job is running - abort!"
  M99

M98 P"0:/sys/meltingplot/confirm_nozzle_diameter.g"

; sformat.g returns the key in global.result - read it straight away
M98 P"0:/sys/meltingplot/sformat.g" F{global.nozzle_diameter[min(max(state.currentTool, 0), 1)]} D2 W0
M291 R"Nozzle diameter" P{"Tool " ^ min(max(state.currentTool, 0), 1) ^ " is set to " ^ global.result ^ "mm. Check the Z offset and calibrate PA/NLE for this nozzle."} S1 T0
M400 ; sbc specific
