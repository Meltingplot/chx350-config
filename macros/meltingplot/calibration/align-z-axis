; ---
; title: Z-Achse ausrichten
; description: Die Z-Motoren am unteren Anschlag zueinander ausrichten
; icon: mdi-align-vertical-center
; page: calibrate
; order: 100
; enabled: "{{ state.status == 'idle' and global.machine_mode == 'automatic' }}"
; hint: Nur in Betriebsart Automatik – Türen schließen
; ---
; calibration/align-z-axis
; Pushes both Z motors against the lower stop to square the bed (z-axis/align-motors.g). Runs
; the full Z travel at reduced current - not during a print and only in automatic mode,
; where default mode would crawl the 950 mm at 60 mm/min.

set global.result = 1 ; every early exit below is a failure for calibration/z-height
if job.file.fileName != null
  echo "Error: a print job is running - abort!"
  M99

if ("" ^ global.machine_mode) != "automatic"   ; hardened read, see globals
  echo "Error: machine not in automatic mode - abort!"
  M99
; confirm the guard (globals, "CONFIRMING") - a guard that is skipped protects nothing
if ("" ^ global.machine_mode) != "automatic"
  echo "Error: automatic mode not confirmed on re-read - abort!"
  M99

M98 P"0:/sys/meltingplot/ce-declaration/doors/ensure-checked-closed.g"
if global.result != 0
  M99
M98 P"0:/sys/meltingplot/z-axis/align-motors.g"

; the flow reached its goal - the CHX 350 UI reports it completed (CLAUDE.md, "Completion").
; Not when calibration/z-height runs it as one of its steps (C0): its own line ends that flow.
if !exists(param.C) || param.C != 0
  echo ";; Completed"
