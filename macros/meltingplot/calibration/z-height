; ---
; title: Z-Nullpunkt kalibrieren
; description: Sonde kalt und warm gegen das Z-Einstellgerät einmessen · bis zu 40 min
; icon: mdi-target
; page: calibrate
; order: 10
; enabled: "{{ state.status == 'idle' and global.machine_mode == 'automatic' and sensors.analog[4].lastReading <= 35 }}"
; hint: Nur in Betriebsart Automatik und mit kaltem Druckkopf (unter 35 °C)
; ---
; calibration/z-height
; Calibrates the scanning Z probe (standard and touch mode, cold and warm) against the
; Z height gauge. Heats the nozzle to 250 C and the bed to 90 C, so it needs automatic
; mode (default mode keeps the heaters off and limited to 50 C), and it must start cold:
; the cold calibration is the first half of the procedure.
; A flow of the CHX 350 UI (CLAUDE.md, "Flows in the CHX 350 UI"): the ;; lines are the
; prompts' texts there. A cancelled prompt restores the Z frame and the soft limits
; (z-probe/cancel-calibration.g) instead of leaving the G92 Z20 shift behind.

if job.file.fileName != null
  echo "Error: a print job is running - abort!"
  M99

if ("" ^ global.machine_mode) != "automatic"   ; hardened read, see globals
  echo "Error: machine not in automatic mode - abort!"
  M99
; confirm the guard (globals, "CONFIRMING") - a guard that is skipped protects nothing
if ("" ^ global.machine_mode) != "automatic"
  echo "Error: automatic mode not confirmed on re-read - abort!"
  M99

; check if printer is cold - before aligning and homing, which take minutes and would be
; wasted if the procedure cannot start anyway
if sensors.analog[4].lastReading > 35
  M291 P{"Printer temp is above 35°C - current " ^ sensors.analog[4].lastReading ^ "<br>Wait until the printer is cold and repeat."} R"Prerequirements" S2
  M99

;; Die Z-Motoren werden am unteren Anschlag ausgerichtet, danach referenziert die Maschine X, Y
;; und U. Das dauert einige Minuten.
M291 R"Ausrichten und referenzieren" P"Z-Achse wird ausgerichtet, X, Y und U werden referenziert." S1 T0
set global.result = 0
M98 P"0:/macros/meltingplot/calibration/align-z-axis"
if global.result != 0
  echo "Error: Z-Axis not aligned!"
  M99

G28 X Y U

M290 R0 S0 ; clear baby stepping

; heat nozzle for thermal expansion
T0 ; select tool with SZP
; heat up the nozzle to 250°C - it is in the mid range of 180 - 400°C without buring the currently loaded material to much
M568 P0 S250 A2 ; heat tool
M140 S0 ; bed must be cold!

;; Die Düse heizt auf 250 °C, das Bett bleibt für die kalte Messung aus.
;;
;; Düse: **{{ heat.heaters[tools[0].heaters[0]].current | round }} °C** von 250 °C
M291 R"Düse heizt auf · kalt" P"Die Düse heizt auf 250 °C." S1 T0
M116 ; wait for heaters

G90 G1 X{move.axes[0].max/2} Y{move.axes[1].max/2} U{move.axes[3].max} F60000
G1 Z120 F6000 ; drive z up to around 120mm -> to be able to place the z-probe on the bed
G92 Z20 ; set z-height to 20mm to prevent accidantly crashing into the probing tool

;; > Die Düse ist **250 °C** heiß – nicht anfassen.
M291 P"Die Düse ist auf 250°C erhitzt, fassen Sie diese nicht an!" R"Heiße Düse · kalt" S2
;; Das Z-Einstellgerät mit der **Tastfläche** auf eine glatte, ebene Fläche drücken und dabei
;; **ZERO** gedrückt halten, bis die Anzeige 0 zeigt.
M291 P"Nullen Sie das Z-Einstellgerät indem Sie es mit der Tastfläche auf eine glatte Fläche drücken und dabei die ZERO Taste gedrückt halten." R"Z-Einstellgerät nullen · kalt" S3 J2
if result != 0
  M98 P"0:/sys/meltingplot/z-probe/cancel-calibration.g" S100
  M99
;; Türen öffnen und das Z-Einstellgerät auf das Druckbett **unter die Düse** stellen. Die Düse
;; muss sauber sein – Reste verfälschen den Nullpunkt.
;;
;; Danach die Türen wieder schließen, erst dann geht es weiter.
M291 P"Öffnen Sie die Türen zum Bauraum, positionieren Sie das Z-Einstellgerät auf dem Druckbett unterhalb der Düse. Vergewissern Sie sich, dass die Düse sauber ist." R"Z-Einstellgerät aufsetzen · kalt" S3 J2
if result != 0
  M98 P"0:/sys/meltingplot/z-probe/cancel-calibration.g" S100
  M99
M98 P"0:/sys/meltingplot/ce-declaration/doors/wait-closed.g"

M564 S0 ; disable boundaries
;; Z in kleinen Schritten absenken (**Z−**), bis die Düse auf dem Z-Einstellgerät aufliegt. Die
;; Kamera zeigt die Düse, zum Schluss mit 0,01 mm annähern.
M291 P"Fahren Sie die Z-Achse in Z- bis die Düse auf dem Höheneinstellgerät aufliegt." R"Düse absenken · kalt" S3 Z1 J2
if result != 0
  M98 P"0:/sys/meltingplot/z-probe/cancel-calibration.g" S100
  M99
M564 S1 ; enable boundaries

var reading = 0

while true
  ;; Den Wert vom Z-Einstellgerät eintragen – in mm (0 bis 3) oder in µm (bis 3000).
  M291 P"Wie lautet der Wert auf dem Z-Einstellgerät?" R"Messwert · kalt" S6
  set var.reading = input
  echo "Reading: " ^ var.reading
  if var.reading >= 0 && var.reading <= 3
    break
  elif var.reading >= 3 && var.reading < 3000
    set var.reading = var.reading / 1000.0
    echo "Convert to mm: " ^ var.reading
    break
  else
    M291 P"Der Wert liegt außerhalb des gültigen Bereichs von 0 bis 3mm." R"Ungültiger Wert" S2
  if iterations > 2
    echo "Abort! Mehrfach einen Wert außerhalb des Intervalls 0 - 3mm angegeben."
    M99

G92 Z{100 + var.reading}
G1 Z120

;; Das Z-Einstellgerät vom Druckbett nehmen und die Türen schließen. Danach kalibriert die
;; Maschine die Sonde selbstständig.
M291 P"Entfernen Sie das Z-Einstellgerät vom Druckbett und schließen Sie die Türen." R"Z-Einstellgerät entfernen · kalt" S3 J2
if result != 0
  M98 P"0:/sys/meltingplot/z-probe/cancel-calibration.g" S0
  M99
M98 P"0:/sys/meltingplot/ce-declaration/doors/wait-closed.g"

;; Die Maschine kalibriert die Sonde im Standard- und im Touch-Modus. Nicht in den Bauraum greifen.
M291 R"Sonde kalibrieren · kalt" P"Die Sonde wird kalibriert." S1 T0
T0 ; select tool with SZP
M568 P0 S250 A2 ; heat tool
M116 ; wait for heaters

M98 P"0:/sys/meltingplot/z-probe/standard-mode.g"

; go down to trigger height + dive height * 1.5
G90 G1 Z{sensors.probes[0].triggerHeight + sensors.probes[0].diveHeights[0] * 1.5}
M400 ; SBC specific

; find the lowest value which gives readings != 999999
var driveCurrent = 15
while true
  ; sensors.probes[0].value[0]
  echo "Test SZP drive current: " ^ {var.driveCurrent}
  M558.2 K0 S{var.driveCurrent} R0
  M400 ; sbc specific
  G4 S1
  if sensors.probes[0].value[0] < 999999
    break
  set var.driveCurrent = var.driveCurrent + 1
  if iterations > 10
    echo "abort! can't find drive current value!"
    M99

; go down to trigger height and calc R such that the trigger value is 9000
G90 G1 Z{sensors.probes[0].triggerHeight}
M400
G4 S1
var readingOffset = sensors.probes[0].value[0] - 9000
M558.2 K0 S{var.driveCurrent} R{var.readingOffset}

; store the values persistent
echo >{"0:/sys/generated/szp-standard-mode-cold.g"} "M558.2 K0 S" ^ {var.driveCurrent} ^ " R" ^ {var.readingOffset}

; align print bed for touch mode
M98 P"0:/sys/bed.g" S1 ; call bed.g without z-probing at the end
M98 P"0:/sys/bed.g" S1 ; call bed.g without z-probing at the end

if global.result != 0
  echo "Error: abort - unable to align bed"
  M99

G90 G1 Z20 F6000
G90 G1 X{move.axes[0].max/2} Y{move.axes[1].max/2} U{move.axes[3].max} F60000

;calibrate touch mode
M98 P"0:/sys/meltingplot/z-probe/touch-mode.g"

; find the lowest value which gives readings != 999999
; start with the standard mode drive current
;set var.driveCurrent = 15
while true
  ; sensors.probes[0].value[0]
  ; go down to drive height + 10%
  G90 G1 Z{sensors.probes[0].diveHeights[0]*1.1}
  M400
  echo "Test SZP drive current: " ^ {var.driveCurrent}
  M558.2 K0 S{var.driveCurrent} R0
  M400 ; sbc specific
  G4 S1
  ; in touch mode the drive current must give readings from about driveHeight down to 0
  if sensors.probes[0].value[0] < 999999
    G90 G1 Z0
    M400
    G4 S1
    if sensors.probes[0].value[0] < 999999
      break

  set var.driveCurrent = var.driveCurrent + 1
  
  if iterations > 10 || var.driveCurrent > 31
    echo "abort! can't find drive current value for touch mode wit"
    M99

; go down to zero height and calc R such that the trigger value is 9000
;G90 G1 Z{sensors.probes[0].diveHeights[0]}
G90 G1 Z0
M400 ; sbc specific
G4 S1
set var.readingOffset = sensors.probes[0].value[0] - 9000
M558.2 K0 S{var.driveCurrent} R{var.readingOffset}
G90 G1 Z{sensors.probes[0].diveHeights[0]}

; store the values persistent
echo >{"0:/sys/generated/szp-touch-mode-cold.g"} "M558.2 K0 S" ^ {var.driveCurrent} ^ " R" ^ {var.readingOffset}

; Calibrate the SZP in warm state
M140 S90 ; enable bed heater
;; Die kalte Messung ist gespeichert. Jetzt heizt das Druckbett auf 90 °C, und die Messung wird
;; warm wiederholt. Das Aufheizen kann bis zu 20 Minuten dauern.
M291 P"Die Kalibrierung im kalten Zustand war erfolgreich.<br>Jetzt wird das Druckbett auf 90°C aufgeheizt und der Vorgang wiederholt. Dies kann bis zu 20 Minuten dauern!" R"Kalte Messung abgeschlossen" S2

;; Das Druckbett heizt auf, der Druckkopf wärmt sich mit auf. Weiter geht es, sobald der Kopf
;; über 50 °C hat.
;;
;; Bett: **{{ heat.heaters[heat.bedHeaterMapping[0][0]].current | round }} °C** von 90 °C ·
;; Druckkopf: **{{ sensors.analog[4].lastReading | round }} °C** von 50 °C
M291 R"Aufwärmen" P"Das Druckbett heizt auf 90 °C, der Druckkopf wärmt sich auf." S1 T0
M116 ; wait for bed heater

while true
; check if printer/SZP is warm
  if sensors.analog[4].lastReading > 50
    break
  if iterations >= 60
    echo "Unable to heat up SZP above 50°C in 10min - abort!"
    M99
  G4 S10

G1 Z120 F6000 ; drive z up to around 120mm -> to be able to place the z-probe on the bed
G92 Z20 ; set z-height to 20mm to prevent accidantly crashing into the probing tool

;; > Die Düse ist **250 °C** und das Druckbett **90 °C** heiß – nicht anfassen.
M291 P"Die Düse ist auf 250°C erhitzt und das Druckbett auf 90°C, fassen Sie diese nicht an!" R"Heiße Düse und heißes Bett · warm" S2
;; Das Z-Einstellgerät mit der **Tastfläche** auf eine glatte, ebene Fläche drücken und dabei
;; **ZERO** gedrückt halten, bis die Anzeige 0 zeigt.
M291 P"Nullen Sie das Z-Einstellgerät indem Sie es mit der Tastfläche auf eine glatte Fläche drücken und dabei die ZERO Taste gedrückt halten." R"Z-Einstellgerät nullen · warm" S3 J2
if result != 0
  M98 P"0:/sys/meltingplot/z-probe/cancel-calibration.g" S100
  M99
;; Das Z-Einstellgerät auf das Druckbett **unter die Düse** stellen. Die Düse muss sauber sein –
;; Reste verfälschen den Nullpunkt.
;;
;; Danach die Türen wieder schließen, erst dann geht es weiter.
M291 P"Positionieren Sie das Z-Einstellgerät auf dem Druckbett unterhalb der Düse. Vergewissern Sie sich, dass die Düse sauber ist." R"Z-Einstellgerät aufsetzen · warm" S3 J2
if result != 0
  M98 P"0:/sys/meltingplot/z-probe/cancel-calibration.g" S100
  M99

M98 P"0:/sys/meltingplot/ce-declaration/doors/wait-closed.g"

M564 S0 ; disable boundaries
;; Z in kleinen Schritten absenken (**Z−**), bis die Düse auf dem Z-Einstellgerät aufliegt. Die
;; Kamera zeigt die Düse, zum Schluss mit 0,01 mm annähern.
M291 P"Fahren Sie die Z-Achse in Z- bis die Düse auf dem Höheneinstellgerät aufliegt." R"Düse absenken · warm" S3 Z1 J2
if result != 0
  M98 P"0:/sys/meltingplot/z-probe/cancel-calibration.g" S100
  M99
M564 S1 ; enable boundaries

set var.reading = 0

while true
  ;; Den Wert vom Z-Einstellgerät eintragen – in mm (0 bis 3) oder in µm (bis 3000).
  M291 P"Wie lautet der Wert auf dem Z-Einstellgerät?" R"Messwert · warm" S6
  set var.reading = input
  echo "Reading: " ^ var.reading
  if var.reading >= 0 && var.reading <= 3
    break
  elif var.reading >= 3 && var.reading < 3000
    set var.reading = var.reading / 1000.0
    echo "Convert to mm: " ^ var.reading
    break
  else
    M291 P"Der Wert liegt außerhalb des gültigen Bereichs von 0 bis 3mm." R"Ungültiger Wert" S2
  if iterations > 2
    echo "Abort! Mehrfach einen Wert außerhalb des Intervalls 0 - 3mm angegeben."
    M99

G92 Z{100 + var.reading}
G1 Z120

;; Das Z-Einstellgerät vom Druckbett nehmen und die Türen schließen. Danach kalibriert die
;; Maschine die Sonde selbstständig.
M291 P"Entfernen Sie das Z-Einstellgerät vom Druckbett und schließen Sie die Türen." R"Z-Einstellgerät entfernen · warm" S3 J2
if result != 0
  M98 P"0:/sys/meltingplot/z-probe/cancel-calibration.g" S0
  M99

M98 P"0:/sys/meltingplot/ce-declaration/doors/wait-closed.g"

;; Die Maschine kalibriert die Sonde im Standard- und im Touch-Modus. Nicht in den Bauraum greifen.
M291 R"Sonde kalibrieren · warm" P"Die Sonde wird kalibriert." S1 T0
T0 ; select tool with SZP
M568 P0 S250 A2 ; heat tool
M116 ; wait for heaters

M98 P"0:/sys/meltingplot/z-probe/standard-mode.g"

; go down to trigger height + dive height * 1.5
G90 G1 Z{sensors.probes[0].triggerHeight + sensors.probes[0].diveHeights[0] * 1.5}
M400 ; SBC specific

; find the lowest value which gives readings != 999999
set var.driveCurrent = 15
while true
  ; sensors.probes[0].value[0]
  echo "Test SZP drive current: " ^ {var.driveCurrent}
  M558.2 K0 S{var.driveCurrent} R0
  M400 ; sbc specific
  G4 S1
  if sensors.probes[0].value[0] < 999999
    break
  set var.driveCurrent = var.driveCurrent + 1
  if iterations > 10
    echo "abort! can't find drive current value!"
    M99

; go down to trigger height and calc R such that the trigger value is 9000
G90 G1 Z{sensors.probes[0].triggerHeight}
M400
G4 S1
set var.readingOffset = sensors.probes[0].value[0] - 9000
M558.2 K0 S{var.driveCurrent} R{var.readingOffset}

; store the values persistent
echo >{"0:/sys/generated/szp-standard-mode-warm.g"} "M558.2 K0 S" ^ {var.driveCurrent} ^ " R" ^ {var.readingOffset}

;calibrate touch mode
M98 P"0:/sys/meltingplot/z-probe/touch-mode.g"

; find the lowest value which gives readings != 999999
; start with the standard mode drive current
;set var.driveCurrent = 15
while true
  ; sensors.probes[0].value[0]
  ; go down to drive height + 20%
  G90 G1 Z{sensors.probes[0].diveHeights[0]*1.2}
  M400

  echo "Test SZP drive current: " ^ {var.driveCurrent}
  M558.2 K0 S{var.driveCurrent} R0
  M400 ; sbc specific
  G4 S1
  ; in touch mode the drive current must give readings from about driveHeight down to 0
  if sensors.probes[0].value[0] < 999999
    G90 G1 Z0
    M400
    G4 S1
    if sensors.probes[0].value[0] < 999999
      break

  set var.driveCurrent = var.driveCurrent + 1
  
  if iterations > 10 || var.driveCurrent > 31
    echo "abort! can't find drive current value for touch mode!"
    M99

; go down to trigger height and calc R such that the trigger value is 9000
;G90 G1 Z{sensors.probes[0].diveHeights[0]}
G90 G1 Z0
M400 ; sbc specific
G4 S1
set var.readingOffset = sensors.probes[0].value[0] - 9000
M558.2 K0 S{var.driveCurrent} R{var.readingOffset}
G90 G1 Z{sensors.probes[0].diveHeights[0]}

; store the values persistent
echo >{"0:/sys/generated/szp-touch-mode-warm.g"} "M558.2 K0 S" ^ {var.driveCurrent} ^ " R" ^ {var.readingOffset}

;M140 S-273.1 ; disable bed heater
;M568 P0 A0 ; disable hotend

; close the last progress box (M291 S1 T0 above) - it would stay open after the macro
if state.messageBox != null
  M292
echo "Finished successful"