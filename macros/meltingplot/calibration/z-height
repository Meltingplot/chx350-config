; ---
; title: Z-Nullpunkt kalibrieren
; description: Sonde kalt und warm einmessen, den Nullpunkt findet die Düse selbst · bis zu 40 min
; icon: mdi-target
; page: service
; order: 110
; enabled: "{{ state.status == 'idle' and global.machine_mode == 'automatic' and sensors.analog[4].lastReading <= 35 }}"
; hint: Nur in Betriebsart Automatik und mit kaltem Druckkopf (unter 35 °C)
; ---
; calibration/z-height
; Calibrates the scanning Z probe (standard and touch mode, cold and warm) without any manual
; step. Heats the nozzle to 250 C and the bed to 90 C, so it needs automatic mode (default
; mode keeps the heaters off and limited to 50 C), and it must start cold: the cold
; calibration is the first half of the procedure.
; The Z zero point comes from z-probe/scan-contact.g, which moves the bed up under the nozzle
; in steps until the probe reading stops rising - the nozzle touches the bed. It replaces the
; Z height gauge. The cold scan runs in the frame align-z-axis leaves (bed at its lower stop =
; global.z_lower_stop, the CAD nominal 950.3 mm), where the contact lies near Z0: above it by
; what a longer nozzle or a thicker plate takes off the travel, below it by the tolerance. The
; warm one runs in the frame of the cold contact.
; A flow of the CHX 350 UI (CLAUDE.md, "Flows in the CHX 350 UI"): the ;; lines are the
; progress steps' texts there. A failed step lowers the bed, restores the soft limits and
; switches the heaters off (z-probe/scan-contact.g, z-probe/cancel-calibration.g).

if job.file.fileName != null
  echo "Error: a print job is running - abort!"
  M99

if ("" ^ global.machine_mode) != "automatic"   ; hardened read, see globals
  echo "Error: machine not in automatic mode - abort!"
  M99
; confirm the guard (globals, "CONFIRMING") - a guard that is skipped protects nothing
if ("" ^ global.machine_mode) != "automatic"
  echo "Error: automatic mode not confirmed on re-read - abort!"
  M99

; check if printer is cold - before aligning and homing, which take minutes and would be
; wasted if the procedure cannot start anyway
if sensors.analog[4].lastReading > 35
  M291 P{"Printer temp is above 35°C - current " ^ sensors.analog[4].lastReading ^ "<br>Wait until the printer is cold and repeat."} R"Prerequirements" S2
  echo "Error: print head above 35 C (" ^ sensors.analog[4].lastReading ^ " C) - wait until it is cold"
  M99

;; Die Z-Motoren werden am unteren Anschlag ausgerichtet, danach referenziert die Maschine X, Y
;; und U. Das dauert einige Minuten.
M291 R"Ausrichten und referenzieren" P"Z-Achse wird ausgerichtet, X, Y und U werden referenziert." S1 T0
set global.result = 0
M98 P"0:/macros/meltingplot/calibration/align-z-axis" C0   ; C0: part of this flow, no completion line of its own
if global.result != 0
  echo "Error: Z-Axis not aligned!"
  M99

G28 X Y U

M290 R0 S0 ; clear baby stepping

; heat nozzle for thermal expansion
T0 ; select tool with SZP
; heat up the nozzle to 250°C - it is in the mid range of 180 - 400°C without buring the currently loaded material to much
M568 P0 S250 A2 ; heat tool
M140 S0 ; bed must be cold!

;; Die Düse heizt auf 250 °C, das Bett bleibt für die kalte Messung aus.
;;
;; Düse: **{{ heat.heaters[tools[0].heaters[0]].current | round }} °C** von 250 °C
M291 R"Düse heizt auf · kalt" P"Die Düse heizt auf 250 °C." S1 T0
M116 ; wait for heaters

;; Die Düse wird gereinigt – Reste an der Spitze verschieben den Nullpunkt. Danach fährt das
;; Bett in der Mitte in kleinen Schritten an die Düse, bis die Sonde den Kontakt erkennt: Der
;; Sondenwert steigt beim Annähern immer schneller und bleibt stehen, sobald die Düse aufliegt.
;;
;; Z: **{{ move.axes[2].userPosition | round(2) }} mm** · Sondenwert: **{{ sensors.probes[0].value[0] }}**
M291 R"Kontakt suchen · kalt" P"Die Düse wird gereinigt, dann fährt das Bett an die Düse, bis die Sonde den Kontakt erkennt." S1 T0
G90 G1 Z200 F6000 ; clean at a safe height, like homez.g
M400
set global.result = 0
M98 P"0:/sys/meltingplot/nozzle-cleaner/clean.g"
if global.result != 0
  echo "Error: nozzle not cleaned - its contact would be off"
  M98 P"0:/sys/meltingplot/z-probe/cancel-calibration.g"
  M99
G90 G1 X{move.axes[0].max/2} Y{move.axes[1].max/2} U{move.axes[3].max} F60000
G1 Z20 F6000
; the contact lies near Z0 of the aligned frame - up to +5 for a thick plate (glass), down to
; -2 for a travel 2 mm over the nominal, where homez.g's touch probe (Z-2.1) ends too:
; start 3 mm above the highest, never below Z-2.5
M98 P"0:/sys/meltingplot/z-probe/scan-contact.g" S8 L-2.5
if global.result != 0
  M98 P"0:/sys/meltingplot/z-probe/cancel-calibration.g"
  M99

;; Der Nullpunkt ist gefunden. Die Maschine kalibriert die Sonde im Standard- und im
;; Touch-Modus. Nicht in den Bauraum greifen.
M291 R"Sonde kalibrieren · kalt" P"Die Sonde wird kalibriert." S1 T0
T0 ; select tool with SZP
M568 P0 S250 A2 ; heat tool
M116 ; wait for heaters

M98 P"0:/sys/meltingplot/z-probe/standard-mode.g"

; go down to trigger height + dive height * 1.5
G90 G1 Z{sensors.probes[0].triggerHeight + sensors.probes[0].diveHeights[0] * 1.5}
M400 ; SBC specific

; find the lowest value which gives readings != 999999
var driveCurrent = 15
while true
  ; sensors.probes[0].value[0]
  echo "Test SZP drive current: " ^ {var.driveCurrent}
  M558.2 K0 S{var.driveCurrent} R0
  M400 ; sbc specific
  G4 S1
  if sensors.probes[0].value[0] < 999999
    break
  set var.driveCurrent = var.driveCurrent + 1
  if iterations > 10
    echo "Error: no SZP drive current found for standard mode - abort!"
    M98 P"0:/sys/meltingplot/z-probe/cancel-calibration.g"
    M99

; go down to trigger height and calc R such that the trigger value is 9000
G90 G1 Z{sensors.probes[0].triggerHeight}
M400
G4 S1
var readingOffset = sensors.probes[0].value[0] - 9000
M558.2 K0 S{var.driveCurrent} R{var.readingOffset}

; store the values persistent
echo >{"0:/sys/generated/szp-standard-mode-cold.g"} "M558.2 K0 S" ^ {var.driveCurrent} ^ " R" ^ {var.readingOffset}

; align print bed for touch mode
M98 P"0:/sys/bed.g" S1 ; call bed.g without z-probing at the end
M98 P"0:/sys/bed.g" S1 ; call bed.g without z-probing at the end

if global.result != 0
  echo "Error: abort - unable to align bed"
  M98 P"0:/sys/meltingplot/z-probe/cancel-calibration.g"
  M99

G90 G1 Z20 F6000
G90 G1 X{move.axes[0].max/2} Y{move.axes[1].max/2} U{move.axes[3].max} F60000

;calibrate touch mode
M98 P"0:/sys/meltingplot/z-probe/touch-mode.g"

; find the lowest value which gives readings != 999999
; start with the standard mode drive current
;set var.driveCurrent = 15
while true
  ; sensors.probes[0].value[0]
  ; go down to drive height + 10%
  G90 G1 Z{sensors.probes[0].diveHeights[0]*1.1}
  M400
  echo "Test SZP drive current: " ^ {var.driveCurrent}
  M558.2 K0 S{var.driveCurrent} R0
  M400 ; sbc specific
  G4 S1
  ; in touch mode the drive current must give readings from about driveHeight down to 0
  if sensors.probes[0].value[0] < 999999
    G90 G1 Z0
    M400
    G4 S1
    if sensors.probes[0].value[0] < 999999
      break

  set var.driveCurrent = var.driveCurrent + 1
  
  if iterations > 10 || var.driveCurrent > 31
    echo "Error: no SZP drive current found for touch mode - abort!"
    M98 P"0:/sys/meltingplot/z-probe/cancel-calibration.g"
    M99

; go down to zero height and calc R such that the trigger value is 9000
;G90 G1 Z{sensors.probes[0].diveHeights[0]}
G90 G1 Z0
M400 ; sbc specific
G4 S1
set var.readingOffset = sensors.probes[0].value[0] - 9000
M558.2 K0 S{var.driveCurrent} R{var.readingOffset}
G90 G1 Z{sensors.probes[0].diveHeights[0]}

; store the values persistent
echo >{"0:/sys/generated/szp-touch-mode-cold.g"} "M558.2 K0 S" ^ {var.driveCurrent} ^ " R" ^ {var.readingOffset}

; Calibrate the SZP in warm state
M140 S90 ; enable bed heater
;; Die kalte Messung ist gespeichert. Jetzt heizt das Druckbett auf 90 °C, der Druckkopf wärmt
;; sich mit auf, dann wird die Messung warm wiederholt. Weiter geht es, sobald der Kopf über
;; 50 °C hat – das kann bis zu 20 Minuten dauern.
;;
;; Bett: **{{ heat.heaters[heat.bedHeaterMapping[0][0]].current | round }} °C** von 90 °C ·
;; Druckkopf: **{{ sensors.analog[4].lastReading | round }} °C** von 50 °C
M291 R"Aufwärmen" P"Die kalte Messung ist gespeichert. Das Druckbett heizt auf 90 °C, der Druckkopf wärmt sich auf." S1 T0
M116 ; wait for bed heater

while true
; check if printer/SZP is warm
  if sensors.analog[4].lastReading > 50
    break
  if iterations >= 60
    echo "Error: SZP not above 50 C after 10 min - abort!"
    M98 P"0:/sys/meltingplot/z-probe/cancel-calibration.g"
    M99
  G4 S10

;; Die Düse wird noch einmal gereinigt, dann sucht das Bett den Kontakt warm – ausgehend vom
;; kalten Nullpunkt, den die Wärme leicht verschiebt.
;;
;; Z: **{{ move.axes[2].userPosition | round(2) }} mm** · Sondenwert: **{{ sensors.probes[0].value[0] }}**
M291 R"Kontakt suchen · warm" P"Die Düse wird gereinigt, dann fährt das Bett an die Düse, bis die Sonde den Kontakt erkennt." S1 T0
G90 G1 Z200 F6000 ; clean at a safe height, like homez.g
M400
set global.result = 0
M98 P"0:/sys/meltingplot/nozzle-cleaner/clean.g"
if global.result != 0
  echo "Error: nozzle not cleaned - its contact would be off"
  M98 P"0:/sys/meltingplot/z-probe/cancel-calibration.g"
  M99
G90 G1 X{move.axes[0].max/2} Y{move.axes[1].max/2} U{move.axes[3].max} F60000
G1 Z20 F6000
; the frame is the cold contact now, the heat moves it by tenths of a millimetre:
; start 2.5 mm above, never below Z-2
M98 P"0:/sys/meltingplot/z-probe/scan-contact.g" S2.5 L-2
if global.result != 0
  M98 P"0:/sys/meltingplot/z-probe/cancel-calibration.g"
  M99

;; Der Nullpunkt ist gefunden. Die Maschine kalibriert die Sonde im Standard- und im
;; Touch-Modus. Nicht in den Bauraum greifen.
M291 R"Sonde kalibrieren · warm" P"Die Sonde wird kalibriert." S1 T0
T0 ; select tool with SZP
M568 P0 S250 A2 ; heat tool
M116 ; wait for heaters

M98 P"0:/sys/meltingplot/z-probe/standard-mode.g"

; go down to trigger height + dive height * 1.5
G90 G1 Z{sensors.probes[0].triggerHeight + sensors.probes[0].diveHeights[0] * 1.5}
M400 ; SBC specific

; find the lowest value which gives readings != 999999
set var.driveCurrent = 15
while true
  ; sensors.probes[0].value[0]
  echo "Test SZP drive current: " ^ {var.driveCurrent}
  M558.2 K0 S{var.driveCurrent} R0
  M400 ; sbc specific
  G4 S1
  if sensors.probes[0].value[0] < 999999
    break
  set var.driveCurrent = var.driveCurrent + 1
  if iterations > 10
    echo "Error: no SZP drive current found for standard mode - abort!"
    M98 P"0:/sys/meltingplot/z-probe/cancel-calibration.g"
    M99

; go down to trigger height and calc R such that the trigger value is 9000
G90 G1 Z{sensors.probes[0].triggerHeight}
M400
G4 S1
set var.readingOffset = sensors.probes[0].value[0] - 9000
M558.2 K0 S{var.driveCurrent} R{var.readingOffset}

; store the values persistent
echo >{"0:/sys/generated/szp-standard-mode-warm.g"} "M558.2 K0 S" ^ {var.driveCurrent} ^ " R" ^ {var.readingOffset}

;calibrate touch mode
M98 P"0:/sys/meltingplot/z-probe/touch-mode.g"

; find the lowest value which gives readings != 999999
; start with the standard mode drive current
;set var.driveCurrent = 15
while true
  ; sensors.probes[0].value[0]
  ; go down to drive height + 20%
  G90 G1 Z{sensors.probes[0].diveHeights[0]*1.2}
  M400

  echo "Test SZP drive current: " ^ {var.driveCurrent}
  M558.2 K0 S{var.driveCurrent} R0
  M400 ; sbc specific
  G4 S1
  ; in touch mode the drive current must give readings from about driveHeight down to 0
  if sensors.probes[0].value[0] < 999999
    G90 G1 Z0
    M400
    G4 S1
    if sensors.probes[0].value[0] < 999999
      break

  set var.driveCurrent = var.driveCurrent + 1
  
  if iterations > 10 || var.driveCurrent > 31
    echo "Error: no SZP drive current found for touch mode - abort!"
    M98 P"0:/sys/meltingplot/z-probe/cancel-calibration.g"
    M99

; go down to trigger height and calc R such that the trigger value is 9000
;G90 G1 Z{sensors.probes[0].diveHeights[0]}
G90 G1 Z0
M400 ; sbc specific
G4 S1
set var.readingOffset = sensors.probes[0].value[0] - 9000
M558.2 K0 S{var.driveCurrent} R{var.readingOffset}
G90 G1 Z{sensors.probes[0].diveHeights[0]}

; store the values persistent
echo >{"0:/sys/generated/szp-touch-mode-warm.g"} "M558.2 K0 S" ^ {var.driveCurrent} ^ " R" ^ {var.readingOffset}

;M140 S-273.1 ; disable bed heater
;M568 P0 A0 ; disable hotend

; close the last progress box (M291 S1 T0 above) - it would stay open after the macro
if state.messageBox != null
  M292
echo "Finished successful"

; the flow reached its goal - the CHX 350 UI reports it completed (CLAUDE.md, "Completion")
echo ";; Completed"
