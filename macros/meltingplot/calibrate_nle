; calibrate_nle
; Measures the non-linear extrusion correction (M592 A/B) against the filament monitor
; over extrusion speeds up to the profile's maximum volumetric flow rate and writes
; filaments/<name>/config-auto-nle-<key>.g (loaded back by tpost0.g). Runs from
; load_filament_sensorless after a load without an NLE file, or as a macro from DWC.
;   M98 P"0:/macros/meltingplot/calibrate_nle" C0
; C0 skips the nozzle confirmation (the load path has just asked), Q1 = silent (no
; message boxes). The calibration temperature always comes from the profile
; (filaments/<name>/temps.g; a profile predating temps.g needs the tool active above the
; cold-extrusion limit) and the tool is heated to it here - see calibrate_e_steps.

; params
var tool = exists(param.T) ? param.T : 0            ; tool number
var calDistance = exists(param.D) ? param.D : 60    ; distance to move in mm for calibration per iteration - should be at least one circumference of the MFM gear and double the distance of the melt zone
var tolerance = exists(param.S) ? param.S : 0.05    ; tolerance in %
var filamentDiameter = 2.85 ; filament diameter in mm
var baseSpeed = exists(param.F) ? param.F / 60 : 0.5 ; base speed in mm/min
var minDistance = 15                                ; minimum distance to extrude in mm for filament sensor calibration
var silent = exists(param.Q) ? param.Q : false      ; silent mode
var confirmNozzle = exists(param.C) ? (param.C != 0) : true ; C0: the caller has already confirmed the nozzle

if var.silent
  set var.silent = true;

set global.result = 0

; the samples are taken while moving X across the bed - never during a print, and only
; in automatic mode (default mode blocks extrusion via M302 S500 and limits every axis
; to 60 mm/min) - hardened read, see globals
if job.file.fileName != null
  echo "Error: a print job is running - abort!"
  set global.result = 12
  M99
if ("" ^ global.machine_mode) != "automatic"
  echo "Error: machine not in automatic mode - abort!"
  set global.result = 12
  M99
; confirm the guard (globals, "CONFIRMING") - a guard that is skipped protects nothing
if ("" ^ global.machine_mode) != "automatic"
  echo "Error: automatic mode not confirmed on re-read - abort!"
  set global.result = 12
  M99

var previousTool = state.currentTool                ; store current tool

var extruder = tools[var.tool].filamentExtruder     ; get current extruder
var currentHeater = tools[var.tool].heaters[0]      ; get current heater
var filament = move.extruders[var.extruder].filament
var previousSampleDistance = sensors.filamentMonitors[var.extruder].configured.sampleDistance ; store current sample distance

if var.filament == null || var.filament == ""
  echo "Error: no filament loaded! abort!"
  set global.result = 13
  M99

; the result is filed under the installed nozzle and the flow rate below comes from the
; nozzle file - ask which nozzle it is the same way the filament change does
; (confirm_nozzle_diameter.g: choice buttons, configured diameter preselected, cancel
; keeps it). The load path has just asked and passes C0.
if var.confirmNozzle && !var.silent
  M98 P"0:/sys/meltingplot/confirm_nozzle_diameter.g" T{var.tool}

; calibration temperature: the profile's active temperature (temps.g sets
; global.filament_temp_active). A profile predating temps.g has no configured value -
; then the tool must already be active above the cold-extrusion limit, and that setpoint
; is used.
var targetTemp = 0
if fileexists("0:/filaments/" ^ var.filament ^ "/temps.g")
  M98 P{"0:/filaments/" ^ var.filament ^ "/temps.g"}
  set var.targetTemp = global.filament_temp_active
elif heat.heaters[var.currentHeater].state == "active" && heat.heaters[var.currentHeater].active >= heat.coldExtrudeTemperature
  set var.targetTemp = heat.heaters[var.currentHeater].active

if var.targetTemp <= 0
  echo "Error: no calibration temperature - filaments/" ^ var.filament ^ "/temps.g missing or invalid (run macro repair-filament-profile) and tool " ^ var.tool ^ " not heated"
  if !var.silent
    M291 P"No calibration temperature: temps.g of this profile is missing or invalid and the tool is not heated. Run the repair-filament-profile macro or heat the tool first." S2
  set global.result = 14
  M99

; the speed range ends at the profile's maximum volumetric flow rate (nozzle-<key>.g or
; config-override.g) - read only now, after the nozzle confirmation may have re-applied it
var requestedVolumetricFlowRate = global.filament_max_flow_rate ; requested volumetric flow rate in mm^3/s
if var.requestedVolumetricFlowRate <= 0
  echo "Error: no maximum volumetric flow rate configured for this filament and nozzle (global.filament_max_flow_rate) - abort!"
  if !var.silent
    M291 P"No maximum volumetric flow rate configured for this filament and nozzle - add it to the profile's nozzle file first." S2
  set global.result = 15
  M99
var requestedMaxSpeed = {ceil(var.requestedVolumetricFlowRate / (pow(var.filamentDiameter,2) * 3.14159 / 4.0) * 2.0) / 2.0} ; volumetric flow rate in mm/s

echo "Requested volumetric flow rate: " ^ {var.requestedVolumetricFlowRate} ^ "mm^3/s"
echo "Filament diameter: " ^ {var.filamentDiameter} ^ "mm"
echo "Requested max speed: " ^ {var.requestedMaxSpeed} ^ "mm/s"

var sampleCount = {floor((var.requestedMaxSpeed - 1)/0.5 + 1) * 2} ; // calculate number of samples based on requested max speed
echo "Sample count: " ^ {var.sampleCount / 2}
var extrusionSpeeds = vector(var.sampleCount, 1.0) ; // create vector for extrusion speeds

while iterations < (var.sampleCount / 2)
  set var.extrusionSpeeds[{iterations*2}] = {1 + (iterations * 0.5)} ; // fill vector with speeds from 0.5 to requested max speed

echo "Extrusion speeds: " ^ {var.extrusionSpeeds}

; the samples move X across the bed at Z 200 - all axes have to be homed for that
if move.axes[0].homed == false || move.axes[1].homed == false || move.axes[2].homed == false || move.axes[3].homed == false
  echo "Axes not homed - homing first"
  G28
  if result != 0 || global.result != 0
    echo "Error: homing failed - abort!"
    set global.result = 16
    M99

if !exists(global.ignoreMFMevents)
  global ignoreMFMevents = true
else
  set global.ignoreMFMevents = true

T-1                                                 ; deselect any tool
T{var.tool}                                         ; select tool

; bring the tool to the calibration temperature - not cold, not standby, not a leftover
; setpoint - and wait for it; the extruder refuses to move below the cold-extrusion limit
if heat.heaters[var.currentHeater].state != "active" || heat.heaters[var.currentHeater].active != var.targetTemp
  echo "Heating tool " ^ var.tool ^ " to " ^ var.targetTemp ^ "C for the NLE calibration"
  M568 P{var.tool} S{var.targetTemp} A2
if heat.heaters[var.currentHeater].current < heat.heaters[var.currentHeater].active
  M116 P{var.tool}                                  ; wait only when heating up
var currentTemp = heat.heaters[var.currentHeater].active ; calibration temperature, recorded in the result file

M83                                                 ; use relative distances for extrusion
M107                                                ; fan off
M220 S100                                           ; reset speed percentage
M221 D{var.extruder} S100                           ; reset flow rate
M572 D{var.extruder} S0                             ; reset pressure advance
M592 D{var.extruder} A0 B0                          ; reset non linear extrusion

var sampleValues = vector(var.sampleCount, 0.0) ; // create vector for sample values

if move.axes[2].machinePosition < 200
  G90 G1 Z200 F6000

while iterations < #var.sampleValues / 2
  M591 D{var.extruder} S0                             ; disable filament monitoring
  M400                                                ; wait for moves to finish
  G4 S1
  M591 D{var.extruder} A1 S2 E1                       ; enable filament monitoring on all moves
  M400                                                ; wait for moves to finish
  G4 S1
  if sensors.filamentMonitors[var.extruder].lastPercentage != null
    echo "Error: unable to reset filament monitor. Please check the configuration of the filament monitor."
    if !var.silent
      M291 P"Unable to reset filament monitor. Please check the configuration of the filament monitor." S2
    T-1                                               ; deselect tool
    T{var.previousTool}                               ; select previous tool
    set global.ignoreMFMevents = false
    set global.result = 1
    M99                                               ; exit macro
  G90                                                ; use absolute coordinates
  G1 X{move.axes[0].max/2} Y0 U{(move.axes[3].max)} F2000 ; move to center of bed
  M400                                               ; wait for moves to finish
  G4 S1
  G91                                               ; use relative coordinates
  G1 X{var.calDistance} E{var.calDistance} F{var.extrusionSpeeds[iterations * 2] * 60}              ; extrude the specified distance
  M400                                                ; wait for moves to finish
  G4 S1
  if sensors.filamentMonitors[var.extruder].avgPercentage == null
    echo "Error: Unvalid values from Filament Monitor received - Check the filament path!"
    T-1                                               ; deselect tool
    T{var.previousTool}                               ; select previous tool
    set global.ignoreMFMevents = false
    set global.result = 2
    M99                                               ; exit macro
  var correction = 100 / sensors.filamentMonitors[var.extruder].avgPercentage
  var previous_index = max(1,iterations-1) ; previous sample index
  if var.correction < 1
    echo "Warning: correction factor is " ^ var.correction ^ " which means that the extruder is overextruding - consider to recalibrate e-steps." 
    set var.correction = 1 ; ensure correction factor is at least 1
  elif var.correction > 1.11 && var.correction < 1.3 ; check if correction factor is within a reasonable range
    echo "Correction to high " ^ {var.correction} ^ " - stop at iteration " ^ {var.previous_index} ^ " with correction factor: " ^ {var.sampleValues[(var.previous_index)*2]}
    set var.sampleCount = {iterations * 2} ; set sample count to current iteration to stop further iterations
    break
  elif var.correction >= 1.3
    echo "Warning: Value to high - try to recover NLE calibration - possible grinding or other issues"
    ; try to recover
    G1 E-5 F120                                         ; retract filament
    G1 E20 F60                                          ; slowly extrude
    M400                                                ; wait for moves to finish
    M591 D{var.extruder} S0                             ; disable filament monitoring
    M400                                                ; wait for moves to finish
    G4 S1
    M591 D{var.extruder} A1 S2 E1                       ; enable filament monitoring on all moves
    M400                                                ; wait for moves to finish
    G4 S1
    G1 E{var.calDistance} F{var.extrusionSpeeds[(var.previous_index) * 2] * 60}              ; extrude the specified distance
    M400                                                ; wait for moves to finish
    G4 S1
    set var.correction = 100 / sensors.filamentMonitors[var.extruder].avgPercentage
    if var.correction > 0.98 && var.correction < 1.3
      set var.sampleCount = {iterations * 2} ; set sample count to current iteration to stop further iterations
      echo "problem solved - continue NLE calibration with sampleCount: " ^ {var.sampleCount/2}
      break
    echo "Error: Value to high - stop NLE calibration - possible grinding or other issues"
    set global.ignoreMFMevents = false
    set global.result = 3
    M99
  
  echo "Extrusion speed: " ^ {var.extrusionSpeeds[iterations*2]} ^ " mm/s, Correction factor: " ^ {var.correction}
  set var.sampleValues[{iterations*2}] = var.correction ; calculate sample value based on correction factor
  set var.extrusionSpeeds[{iterations*2+1}] = {var.extrusionSpeeds[iterations*2] * var.correction} ; adjust extrusion speed based on correction factor

G1 E-5 F120
G1 E20 F60
M400
; repeat the sample collection - this time with calculated extrusion speeds
while iterations < #var.sampleValues / 2
  M591 D{var.extruder} S0                             ; disable filament monitoring
  M400                                                ; wait for moves to finish
  G4 S1
  M591 D{var.extruder} A1 S2 E1                       ; enable filament monitoring on all moves
  M400                                                ; wait for moves to finish
  G4 S1
  var previous_index = max(1,iterations-1) ; previous sample index
  if sensors.filamentMonitors[var.extruder].lastPercentage != null
    echo "Error: unable to reset filament monitor. Please check the configuration of the filament monitor."
    if !var.silent
      M291 P"Unable to reset filament monitor. Please check the configuration of the filament monitor." S2
    T-1                                               ; deselect tool
    T{var.previousTool}                               ; select previous tool
    set global.ignoreMFMevents = false
    set global.result = 4
    M99                                               ; exit macro
  G90                                                ; use absolute coordinates
  G1 X{move.axes[0].max/2} F2000 ; move to center of bed
  M400                                               ; wait for moves to finish
  G4 S1
  G91                                               ; use relative coordinates
  G1 X{var.calDistance} E{var.calDistance} F{var.extrusionSpeeds[iterations*2+1] * 60}              ; extrude the specified distance
  M400                                                ; wait for moves to finish
  G4 S1
  if sensors.filamentMonitors[var.extruder].avgPercentage == null
    echo "Error: Unvalid values from Filament Monitor received - Check the filament path!"
    T-1                                               ; deselect tool
    T{var.previousTool}                               ; select previous tool
    set global.ignoreMFMevents = false
    set global.result = 5
    M99                                               ; exit macro
  var correction = 100 / sensors.filamentMonitors[var.extruder].avgPercentage
  if var.correction < 1
    set var.correction = 1 ; ensure correction factor is at least 1
  elif var.correction > 1.25 && var.correction < 1.3 ; check if correction factor is within a reasonable range
    echo "Correction to high " ^ {var.correction} ^ " - stop at iteration " ^ {iterations} ^ " with correction factor: " ^ {var.sampleValues[iterations*2]}
    set var.sampleCount = {iterations * 2} ; set sample count to current iteration to stop further iterations
    break
  elif var.correction >= 1.3 && iterations > 0
    echo "Warning: Value (" ^ var.correction ^ ") to high - try to recover NLE calibration - possible grinding or other issues"
    ; try to recover
    G1 E-5 F120
    G1 E20 F60
    M400
    M591 D{var.extruder} S0                             ; disable filament monitoring
    M400                                                ; wait for moves to finish
    G4 S1
    M591 D{var.extruder} A1 S2 E1                       ; enable filament monitoring on all moves
    M400                                                ; wait for moves to finish
    G4 S1
    G1 E{var.calDistance} F{var.extrusionSpeeds[(var.previous_index) * 2] * 60}              ; extrude the specified distance
    M400                                                ; wait for moves to finish
    G4 S1
    set var.correction = 100 / sensors.filamentMonitors[var.extruder].avgPercentage
    if var.correction > 0.98 && var.correction < 1.3
      set var.sampleCount = {iterations * 2} ; set sample count to current iteration to stop further iterations
      echo "problem solved - continue NLE calibration with sampleCount: " ^ {var.sampleCount/2}
      break
    echo "Error: Value (" ^ var.correction ^ ") to high - stop NLE calibration - possible grinding or other issues"
    set global.result = 6
    M99
  elif var.correction >= 1.3 && iterations == 0
    echo "Extrusion speed: " ^ {var.extrusionSpeeds[iterations*2+1]} ^ " mm/s, Correction factor: " ^ {var.correction}
    echo "Error: NLE calibration failed! - check the filament and extruder"
    T-1                                               ; deselect tool
    T{var.previousTool}                               ; select previous tool
    set global.ignoreMFMevents = false
    set global.result = 7
    M99
  echo "Extrusion speed: " ^ {var.extrusionSpeeds[iterations*2+1]} ^ " mm/s, Correction factor: " ^ {var.correction}
  set var.sampleValues[{iterations*2+1}] = var.correction ; calculate sample value based on correction factor

while iterations < var.sampleCount
  echo "Sample " ^ {iterations} ^ ": Extrusion speed: " ^ {var.extrusionSpeeds[iterations]} ^ " mm/s, Correction factor: " ^ {var.sampleValues[iterations]}

G1 E{var.calDistance} F60 ; slowly extrude material to free the extruder
M400

var nle_a = 0.0
var nle_b = 0.0

while true
  ;// Annahme: Arrays v[1..N], y[1..N], x[1..N]
  ;N = Anzahl Messpunkte
  ;
  ;// Initialisierung
  var failed = false
  var S_v = 0
  var S_v2 = 0
  var S_v3 = 0
  var S_t = 0
  var S_tv = 0
  set var.nle_a = 0.0
  set var.nle_b = 0.0

  ;for i = 1 to N
  ;    t = y[i] / x[i] - 1
  ;    S_v  = S_v  + v[i]
  ;    S_v2 = S_v2 + v[i] * v[i]
  ;    S_v3 = S_v3 + v[i] * v[i] * v[i]
  ;    S_t  = S_t  + t
  ;    S_tv = S_tv + t * v[i]
  ;end

  var x = 0
  while var.x < var.sampleCount
    set var.S_v = var.S_v + var.extrusionSpeeds[var.x]
    set var.S_v2 = var.S_v2 + pow(var.extrusionSpeeds[var.x], 2)
    set var.S_v3 = var.S_v3 + pow(var.extrusionSpeeds[var.x], 3)
    set var.S_t = var.S_t + (var.sampleValues[var.x] - 1.0)
    set var.S_tv = {var.S_tv + (var.sampleValues[var.x]  - 1.0) * var.extrusionSpeeds[var.x]}
    set var.x = var.x + 1

  ;Delta = S_v * S_v3 - S_v2 * S_v2
  ;A = (S_t * S_v3 - S_tv * S_v2) / Delta
  ;B = (S_tv * S_v - S_t * S_v2) / Delta

  var Delta = {var.S_v * var.S_v3 - var.S_v2 * var.S_v2}
  set var.nle_a = {(var.S_t * var.S_v3 - var.S_tv * var.S_v2) / var.Delta}
  set var.nle_b = {(var.S_tv * var.S_v - var.S_t * var.S_v2) / var.Delta}
  echo "S_v: " ^ {var.S_v} ^ ", S_v2: " ^ {var.S_v2} ^ ", S_v3: " ^ {var.S_v3}
  echo "S_t: " ^ {var.S_t} ^ ", S_tv: " ^ {var.S_tv}
  echo "Delta: " ^ {var.Delta} ^ ", A: " ^ {var.nle_a} ^ ", B: " ^ {var.nle_b}

  if isnan(var.nle_a) || isnan(var.nle_b)
    echo "Error: Unvalid values for A and B - abort!"
    T-1                                               ; deselect tool
    T{var.previousTool}                               ; select previous tool
    set global.ignoreMFMevents = false
    set global.result = 8
    M99                                               ; exit macro

  M592 D{var.extruder} A{max(0,var.nle_a)} B{var.nle_b}                          ; activate non linear extrusion

  set var.x = 0
  while var.x < var.sampleCount / 2
    M591 D{var.extruder} S0                             ; disable filament monitoring
    M400                                                ; wait for moves to finish
    G4 S1
    M591 D{var.extruder} A1 S2 E1                       ; enable filament monitoring on all moves
    M400                                                ; wait for moves to finish
    G4 S1
    if sensors.filamentMonitors[var.extruder].lastPercentage != null
      echo "Error: unable to reset filament monitor. Please check the configuration of the filament monitor."
      if !var.silent
        M291 P"Unable to reset filament monitor. Please check the configuration of the filament monitor." S2
      T-1                                               ; deselect tool
      T{var.previousTool}                               ; select previous tool
      set global.ignoreMFMevents = false
      set global.result = 9
      M99                                               ; exit macro
    G90                                                ; use absolute coordinates
    G1 X{move.axes[0].max/2} F2000 ; move to center of bed
    M400                                               ; wait for moves to finish
    G4 S1
    G91                                               ; use relative coordinates
    var startPos = move.extruders[0].position
    G1 X{var.calDistance} E{var.calDistance} F{var.extrusionSpeeds[var.x * 2] * 60}              ; extrude the specified distance
    M400                                                ; wait for moves to finish
    G4 S1
    var diffPos = move.extruders[0].position - var.startPos 
    if sensors.filamentMonitors[var.extruder].avgPercentage == null
      echo "Error: Unvalid values from Filament Monitor received - Check the filament path!"
      T-1                                               ; deselect tool
      T{var.previousTool}                               ; select previous tool
      set global.ignoreMFMevents = false
      set global.result = 10
      M99                                               ; exit macro
    var correction = {(100 * var.calDistance) / (sensors.filamentMonitors[var.extruder].avgPercentage * var.diffPos)};
    ;var correction = 100 / ( ( (sensors.filamentMonitors[var.extruder].avgPercentage / 100 ) * var.diffPos) / var.calDistance * 100)
    echo "Extrusion speed: " ^ {var.extrusionSpeeds[var.x*2]} ^ " mm/s, Correction factor: " ^ {var.correction}
    if var.correction < 1
      set var.correction = 1 ; ensure correction factor is at least 1
    elif var.correction > (1/(1-var.tolerance)) ; check if correction factor is within a reasonable range
      echo "Correction to high " ^ {var.correction} ^ " - stop at iteration " ^ {var.x-1} ^ " with correction factor: " ^ {var.sampleValues[(var.x-1)*2]}
      set var.sampleCount = {max(var.x * 2 - 2, 0)} ; set sample count to current iteration to stop further iterations
      if var.sampleCount == 0
        echo "Error: No more samples to remove - failed NLE calibration"
        T-1                                               ; deselect tool
        T{var.previousTool}                               ; select previous tool
        set global.ignoreMFMevents = false
        set global.result = 11
        M99
      set var.failed = true ; set failed flag to true
      break
    set var.x = var.x + 1

  if var.failed == false
    break

echo "NLE calibration finished!"
echo "M592 D" ^ var.extruder ^ " A" ^ var.nle_a ^ " B" ^ var.nle_b ^ " L0.2"
; the result belongs to the nozzle it was calibrated with - loaded back by tpost0.g
; sformat.g returns the key in global.result - read it straight away
M98 P"0:/sys/meltingplot/sformat.g" F{global.nozzle_diameter[var.tool]} D2 W0
var nozzleKey = global.result
var autoFile = "0:/filaments/" ^ move.extruders[0].filament ^ "/config-auto-nle-" ^ var.nozzleKey ^ ".g"
echo >{var.autoFile} "; max F" ^ {var.extrusionSpeeds[var.sampleCount -1] * 60} ^ " mm/min or " ^ {var.extrusionSpeeds[var.sampleCount -1] * 6.38} ^ "mm³/s"
echo >>{var.autoFile} "; temp: " ^ var.currentTemp ^ " °C, nozzle: " ^ var.nozzleKey ^ "mm"
echo >>{var.autoFile} "M592 D0 A" ^ var.nle_a ^ " B" ^ var.nle_b ^ " L0.2"

M591 D{var.extruder} A1 S1 E{var.previousSampleDistance}  ; reset filament sensor
M98 P"0:/sys/meltingplot/machine-override"                ; Load Machine specific overrides

T-1                                               ; deselect tool
T{var.previousTool}                               ; select previous tool

set global.ignoreMFMevents = false                ; reactivate filament errors

; the sformat.g call above left the nozzle key string in global.result - restore the
; integer success code so the caller can compare it against the error codes set here
set global.result = 0
