; calibrate_z_height_automatic
; Calibrates the scanning Z probe without any manual step: the drive currents of standard and
; touch mode, cold and warm, and the touch mode's Z offset (global.szp_touch_z_offset, M558.3
; H) - where a touch probe stops, measured against the real nozzle contact. homez.g sets
; Z = H where its touch stops, so H is what puts Z0 on the bed. It replaces whatever the
; babystep macros (z-probe/offset/*) had put there; they trim it again from the next print on.
; Heats the nozzle to 250 C and the bed to 90 C, so it needs automatic mode (default mode
; keeps the heaters off and limited to 50 C, and the nozzle cleaner only runs in automatic
; mode), and it must start cold: the cold calibration is the first half of the procedure.
; The contact comes from z-probe/scan-contact.g: the bed approaches the nozzle until the
; probe reading stops rising, then backs off until it falls again - there the nozzle lifts
; off, Z0. It replaces the Z height gauge. The first cold scan runs in the frame align_z_axis
; leaves (bed at its lower stop = M208's Z max), where the contact lies within reach of
; homez.g's touch probe on every machine that homes: no deeper than Z-2.1 (Z min - dive
; height + touch H), higher by what a longer nozzle or a thicker plate takes off the travel.
; It gives bed.g the frame its touch probes need.
; Levelling moves the bed at the centre (G32 also corrects the mean), so a second cold scan
; sets the Z0 the cold calibration uses. The warm scan runs in the frame of the cold contact;
; no levelling follows it.
; The calibration itself is z-probe/calibrate.g. The warm run's touch stop height becomes the
; Z offset, because homing before a print runs warm; the cold one is reported beside it.
; A failed step lowers the bed, restores the soft limits and switches the heaters off
; (z-probe/scan-contact.g, z-probe/calibrate.g, z-probe/cancel-calibration.g).

if job.file.fileName != null
  echo "Error: a print job is running - abort!"
  M99

if global.machine_mode != "automatic"
  echo "Error: machine not in automatic mode - abort!"
  M99

; check if printer is cold - before aligning and homing, which take minutes and would be
; wasted if the procedure cannot start anyway
if sensors.analog[4].lastReading > 35
  M291 P{"Printer temp is above 35°C - current " ^ sensors.analog[4].lastReading ^ "<br>Wait until the printer is cold and repeat."} R"Prerequirements" S2
  echo "Error: print head above 35 C (" ^ sensors.analog[4].lastReading ^ " C) - wait until it is cold"
  M99

; progress boxes are S1 T3600, never T0: RRF queues message boxes and shows only the head,
; a new box cuts every earlier non-blocking one with a timeout to 1 s - a T0 box would stay
; at the head and hide every later one, a blocking prompt included (MessageBox.cpp)
M291 R"Ausrichten und referenzieren" P"Z-Achse wird ausgerichtet, X, Y und U werden referenziert." S1 T3600
set global.result = 0
M98 P"0:/macros/meltingplot/align_z_axis"
if global.result != 0
  echo "Error: Z-Axis not aligned!"
  M99

G28 X Y U

M290 R0 S0 ; clear baby stepping

T0 ; select tool with SZP
; 250 C: in the mid range of 180 - 400 C, without burning the loaded material too much. The
; nozzle stays at it for the whole procedure - its thermal expansion is part of the contact
M568 P0 S250 A2 ; heat tool
M140 S0 ; bed must be cold!

M291 R"Düse heizt auf · kalt" P"Die Düse heizt auf 250 °C." S1 T3600
M116 ; wait for heaters

M291 R"Kontakt suchen · kalt" P"Die Düse wird gereinigt, dann fährt das Bett an die Düse, bis die Sonde den Kontakt erkennt." S1 T3600
; the contact lies near Z0 of the aligned frame - up to +5 for a thick plate (glass), down to
; Z-2.1 where homez.g's touch probe ends: start 3 mm above the highest, never below Z-2.5
M98 P"0:/sys/meltingplot/z-probe/scan-contact.g" S8 L-2.5
if global.result != 0
  M98 P"0:/sys/meltingplot/z-probe/cancel-calibration.g"
  M99

M291 R"Bett ausrichten · kalt" P"Das Druckbett wird an vier Punkten angetastet und ausgerichtet." S1 T3600
; level the bed in the frame of the contact just found: bed.g's touch probes dive to Z1.9 and
; end at Z-2.1, too narrow for the aligned frame. G32 fits all four leadscrews exactly, the mean
; included (ZLeadscrewKinematics.cpp: residuals 0), so it moves the bed at the centre by the
; mean of the four touch heights (0.279 mm on 2026-10-19, the second scan found the centre
; 0.268 mm lower) - S1 only skips bed.g's own centre probe. The second scan finds the contact
; again, in the levelled bed.
M98 P"0:/sys/bed.g" S1 ; call bed.g without z-probing at the end
if global.result != 0
  echo "Error: abort - unable to align bed"
  M98 P"0:/sys/meltingplot/z-probe/cancel-calibration.g"
  M99
M98 P"0:/sys/bed.g" S1 ; call bed.g without z-probing at the end
if global.result != 0
  echo "Error: abort - unable to align bed"
  M98 P"0:/sys/meltingplot/z-probe/cancel-calibration.g"
  M99

M291 R"Kontakt nachmessen · kalt" P"Die Düse wird gereinigt, dann sucht das Bett den Kontakt im ausgerichteten Bett erneut." S1 T3600
; the levelling moved the centre by the mean of the touch heights, tenths of a millimetre, and
; never by more than its touch probes measure (dive from Z1.9, end at Z-2.1):
; start 2.5 mm above, never below Z-2
M98 P"0:/sys/meltingplot/z-probe/scan-contact.g" S2.5 L-2
if global.result != 0
  M98 P"0:/sys/meltingplot/z-probe/cancel-calibration.g"
  M99

M291 R"Sonde kalibrieren · kalt" P"Die Sonde wird kalibriert." S1 T3600
M568 P0 S250 A2 ; heat tool
M116 ; wait for heaters
M98 P"0:/sys/meltingplot/z-probe/calibrate.g" S"cold"   ; touch stop height reported, not taken over
if global.result != 0
  M98 P"0:/sys/meltingplot/z-probe/cancel-calibration.g"
  M99

M140 S90 ; enable bed heater
M291 R"Aufwärmen" P"Die kalte Messung ist gespeichert. Das Druckbett heizt auf 90 °C, der Druckkopf wärmt sich auf. Das kann bis zu 20 Minuten dauern." S1 T3600
M116 ; wait for bed heater

while true
  ; check if printer/SZP is warm
  if sensors.analog[4].lastReading > 50
    break
  if iterations >= 60
    echo "Error: SZP not above 50 C after 10 min - abort!"
    M98 P"0:/sys/meltingplot/z-probe/cancel-calibration.g"
    M99
  G4 S10

M291 R"Kontakt suchen · warm" P"Die Düse wird gereinigt, dann fährt das Bett an die Düse, bis die Sonde den Kontakt erkennt." S1 T3600
; the frame is the cold contact now, the heat moves it (+0.7 mm on 2026-10-19, bed at 90 C,
; head just above 50 C): start 2.5 mm above, never below Z-2
M98 P"0:/sys/meltingplot/z-probe/scan-contact.g" S2.5 L-2
if global.result != 0
  M98 P"0:/sys/meltingplot/z-probe/cancel-calibration.g"
  M99

M291 R"Sonde kalibrieren · warm" P"Die Sonde wird kalibriert und ihr Z-Offset neu bestimmt." S1 T3600
M568 P0 S250 A2 ; heat tool
M116 ; wait for heaters
M98 P"0:/sys/meltingplot/z-probe/calibrate.g" S"warm" H1   ; H1: the touch stop height becomes szp_touch_z_offset
if global.result != 0
  M98 P"0:/sys/meltingplot/z-probe/cancel-calibration.g"
  M99

;M140 S-273.1 ; disable bed heater
;M568 P0 A0 ; disable hotend

; close the last progress box (M291 S1 T3600 above) - it would stay open for its hour otherwise
if state.messageBox != null
  M292
echo "Finished successful - szp_touch_z_offset " ^ global.szp_touch_z_offset
