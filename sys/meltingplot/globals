; Global variables for MeltingPlot system

; activate debug messages
global debug = false

; result variable for macros
global result = 0

; filament
global filament_max_flow_rate = 20
; nozzle temperature (C) the last filament was unloaded at - written by unload_filament,
; used by load_filament_sensorless to detect high-temp residue in the nozzle.
; persisted to a file because the residue survives a power cycle.
global last_filament_temp = 0
if fileexists("0:/sys/meltingplot/last-filament-temp.g")
  M98 P"0:/sys/meltingplot/last-filament-temp.g"
global filament_loading_error = false
; per-tool deferred physical load, armed by filament_load.g (from load.g), consumed by
; load_filament_sensorless_conditionally.g (from the machine-generated config.g).
; Sized explicitly because globals load before tools exist.
global deferred_filament_load = vector(2, false)
; legacy shim: load.g files generated before 2026-07 still set this flag. Nothing
; consumes it anymore (the watchdog flags such profiles for repair), but it must
; exist so an old load.g does not hard-error with "unknown variable".
global deferred_filament_load_t0 = false
; filament-profile watchdog (daemon.g): a DWC-created profile missing the standard
; M98 lines fails silently — M701 registers the filament in the OM but nothing is
; ever physically loaded. Detection is behavioral (fileread cannot parse G-code).
global filament_physical_load_name = ""      ; filament whose physical load was dispatched by conditionally.g ("" = none)
global filament_physical_unload_done = false ; set by unload_filament; checked by daemon.g on the OM name -> "" transition
global filament_forced_unload = false        ; daemon-initiated M702: one-shot, skip the physical unload; self-cleared by filament_unload.g/unload_filament
global filament_broken_profile = ""          ; profile name captured by the watchdog before the forced unload (for the repair macro)
; per-profile temperatures, set by filaments/<name>/temps.g (executed by
; filament_load.g/filament_unload.g when called with F"<name>"). temps.g is the
; canonical per-material temperature store: load.g/unload.g are machine-generated
; boilerplate and M98's R parameter is the pause flag (NOT passed to the macro),
; so temperatures can neither live in nor be passed into those files.
global filament_temp_active = 0              ; extrusion/load temperature
global filament_temp_standby = 0             ; standby temperature
global filament_temp_unload = 0              ; unload temperature (0 = same as active)
global mfmbackoff = 3
global ignoreMFMevents = false
global lastMFMBackoffCheck = 0

; MFM false positive detection
global mfm_last_pct = null                ; previous lastPercentage reading
global mfm_swing_count = 0                ; large-swing count in current window
global mfm_window_start = 0               ; window start time (upTime)
global mfm_suppress_until = 0             ; upTime until which to suppress (0 = not active)
global mfm_last_check_time = 0.0          ; last MFM check timestamp (sub-second precision)
; MFM persistent error tracking (survives swing suppressions and fast-track resets)
global mfm_error_extruder_ref = null      ; extruder position at first error in sequence (null = no active tracking)
global mfm_normal_since = 0               ; upTime when sustained normal readings began
global mfm_recovery_last_ok = 0           ; upTime of last auto-recovery pass + auto-resume (0 = none); loop breaker in filament-error.g
; MFM systematic flow-bias (e-steps). DETECT in daemon.g (non-blocking); APPLY only at standstill
; in filament-error.g when the next MFM error pauses the print — M92 blocks, forbidden in daemon.g.
global mfm_esteps_done = false            ; one-shot detection guard for this print, reset in print_end
global mfm_esteps_check_time = 0          ; last flow-bias sample timestamp (upTime)
global mfm_esteps_drift_since = 0         ; upTime when the current settle window started (0 = inside deadband/no drift)
global mfm_esteps_drift_avg = 0           ; avgPercentage at the start of the settle window (flatness reference)
global mfm_esteps_suggested = 0           ; bounded (±5%) target steps/mm computed by the detector (0 = none pending)
global mfm_esteps_baseline = 0.0          ; e-steps captured before the correction was applied (0 = not applied; for print_end restore)
; heater PWM tracking for extrusion verification
global mfm_pwm_min = 0.0                  ; min avgPwm in current window
global mfm_pwm_max = 0.0                  ; max avgPwm in current window
global mfm_pwm_range = 0.0                ; computed range from last complete window
global mfm_pwm_window_start = 0           ; PWM window start time

; idle heater cutoff — per-heater, indexed by heater number. Heater 0 = bed by
; definition; heaters 1..#tools = tool heaters (heater h ↔ tool h-1); further
; heaters may follow. Sized explicitly because globals load before heaters exist.
global idle_heater_timeout = {3600, 1800}                                   ; cutoff timeout (s): [0]=bed 60min, [1]=hotend 30min
global idle_heater_pause_hold = {true, false}                               ; true = keep on while paused with a job loaded (bed: preserve adhesion for resume)
global idle_heater_cutoff_done = vector(#global.idle_heater_timeout, false)  ; per-heater edge flag — set after cutoff, cleared on re-enable/activity
global idle_since = 0                                                        ; state.upTime of last detected activity (0 = init pending)

; homing and stall detection
global closed_loop_homing = false

global ignore_stall_events = false
global sensorless_z_homing = false
global z_motor_stall_count = vector(4,0)
global z_motor_stall_time = 0
global z_motor_stall_time_max = 5
global szp_touch_z_offset = -0.1        ; M558.3 H param — assumed nozzle Z (mm) at touch detection (less negative = closer to bed)
global szp_warm_threshold = 40           ; temperature (°C) above which warm calibration is used for scanning Z-probe

; machine state
global machine_mode = "default"
global daemon_cycle_time = 0
global potential_unsafe_state = true
global machine_is_hot = true
global door_left_open = true
global door_right_open = true
global door_left_state_transition = false
global door_right_state_transition = false
global door_left_switch_checked = false
global door_right_switch_checked = false
global door_ignore_trigger = false

global saved_bed_heater_state = "off"                    ; bed heater state before door open
global saved_tool_heater_states = vector(1, "off")       ; per-tool heater state before door open

global last_machine_position = vector(4,0)
global axis_is_moving = vector(4,0)
global last_axis_motion_time = vector(4,0.0)
global last_extruder_position = vector(2,0)
global extruder_is_moving = vector(2,0)
global last_extruder_motion_time = vector(2,0.0)

; pause and resume
global ramp_up_after_pause = true
global ramp_up_step = 0

; led colors
global led_color = 0
global led_colors = {"white", "blue", "green", "yellow", "red"}

; daemon reload flag
global daemon_reload = false