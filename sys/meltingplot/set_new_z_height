var motor_current = move.axes[2].percentCurrent
set global.sensorless_z_homing = true      ; ignore stall events on z-axis

M915 Z R2                            ; set z axis to stall detection mode
G91                                  ; relative position
M400                                 ; make sure everything has stopped before we reset the motor currents
M913 Z{500/move.axes[2].current*100} ; set motor current
G1 H3 Z{(move.axes[2].max)+5} F2000  ; lower z axis
M400                                 ; make sure everything has stopped before we reset the motor currents
M913 Z100                            ; motor currents back to normal
G1 Z-2.5 F960                        ; raise z 2.5mm
G90                                  ; absolute position
M208 Z0 S1                           ; overwrite probed z minimum to 0
M500 P10:31                          ; store new z height in config-overwrite.g
M915 Z R0                            ; set z axis back to normal mode
G4 P500                              ; wait for 500ms to make sure the z axis is not moving anymore before we disable sensorless homing
set global.sensorless_z_homing = false      ; ignore stall events on z-axis