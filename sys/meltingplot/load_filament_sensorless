if global.debug
  echo "load_filament_sensorless"

M98 P"0:/sys/meltingplot/ensure_safety"

if state.currentTool == -1
  echo "No tool selected - abort!"
  M400 ; sbc specific
  M99

if move.axes[0].homed == false || move.axes[1].homed == false || move.axes[3].homed == false
  G28 X ; home x axis -> will also home y and u axis

if move.axes[2].homed == false
  G28 Z;

; the z-height must be hight enough to allow the cleaner to raise 50mm
if move.axes[2].homed == true && move.axes[2].machinePosition < (move.axes[2].max - 55)
  G90 G1 Z{move.axes[2].max-55} F6000; raise printbed to the bottom to prevent damage while feeding filament

; this position is better suited to feed filament because the extruder is closer to the middle
; of the bed and the filament can be fed in straighter which is better for the filament sensors
G1 X300 Y0 F60000 ; move to the middle of the bed

M400 ; wait for motion system to finish

; when the previously unloaded material needed a high nozzle temperature, its residue
; cannot be pushed out at a low-temp filament's loading temperature. load at 280C and
; only drop to the filament temperature for the e-steps calibration.
var load_temp = tools[0].active[0]
var hightemp_purge = false
if global.last_filament_temp >= 260 && var.load_temp < 280
  set var.hightemp_purge = true
  echo "Previous filament was unloaded at " ^ global.last_filament_temp ^ "C - loading at 280C to purge residue"
  M568 P0 S280 A2 ; heats up while the operator feeds the filament

M291 P"Feed new Filament into the PTFE Tube." S2

if var.hightemp_purge
  M116 P0 ; wait for the purge temperature before filament reaches the nozzle

var tool = 0
var extruder = tools[var.tool].extruders[0]
var filament = move.extruders[var.extruder].filament

M83                 ; relative extrusion
M17 E0              ; activate tool board motor! bug in 3.6.1

if exists(global.ignoreMFMevents)
  set global.ignoreMFMevents = true
else
  global ignoreMFMevents = true

M591 D{var.tool} S0 A0
M591 D{var.tool} S2 A1 ; enable MFM on all moves

var last_position = sensors.filamentMonitors[var.tool].position
var last_avg_percantage = sensors.filamentMonitors[var.tool].avgPercentage
if var.last_avg_percantage == null
  set var.last_avg_percantage = 0

var drive_filament = 0
var filament_loaded = false

while true
  var position = sensors.filamentMonitors[var.tool].position
  var movment = (var.position - var.last_position) != 0

  if var.movment && var.drive_filament == 0
    echo "manual feed detected - pos: " ^ var.position ^ " lastPos: " ^ var.last_position
    set var.drive_filament = 12

  if var.drive_filament > 0
    G1 E10 F120
  
  var avg_percantage = sensors.filamentMonitors[var.tool].avgPercentage
  if var.avg_percantage == null
    set var.avg_percantage = 0

  M400 ; sync system
  G4 P250 ; SBC specific

  if var.drive_filament > 0 && var.avg_percantage > 20
    set var.filament_loaded = true
    if var.last_avg_percantage < 20
      echo "Filament movment by drive detected"
      G1 E30 F120 ; extrude 15mm calc distance 10mm per drive e.g. 25mm, length from hobb wheel to nozzle 65mm -> 30mm
      set var.drive_filament = 1 ; extrude 10mm more to check if filament is stuck
  
  var last_percentage = sensors.filamentMonitors[var.tool].lastPercentage
  if var.last_percentage == null
    set var.last_percentage = 0

  if var.filament_loaded && (var.avg_percantage < 20 || var.last_percentage < 10)
    echo "Filament stuck! cancle loading"
    M98 P"0:/sys/meltingplot/unload_filament"
    set global.filament_loading_error = true
    break

  if iterations > 240 ; 60s
    echo "abort"
    M98 P"0:/sys/meltingplot/unload_filament"
    set global.filament_loading_error = true
    break

  if var.drive_filament > 0
    set var.drive_filament = var.drive_filament - 1

    if var.drive_filament == 0 && var.filament_loaded == false
      echo "Filament loading failed"
      M98 P"0:/sys/meltingplot/unload_filament"
      set global.filament_loading_error = true
      break

  if var.drive_filament == 0 && var.filament_loaded
    echo "Filament loaded!"
    break

  set var.last_position = var.position
  set var.last_avg_percantage = var.avg_percantage

set global.ignoreMFMevents = false
M591 D{var.tool} S1 A0

; loading done - drop from the 280C purge temperature back to the filament temperature
if var.hightemp_purge
  M568 P0 S{var.load_temp} A2
  if global.filament_loading_error == false
    M106 S255 ; part fan speeds up cooling; calibrate_e_steps turns it off again (M107)
    M116 P0   ; wait for the nozzle to cool down before the e-steps calibration
    M106 S0

if global.filament_loading_error == false
  ; calibrate e-steps
  echo "calibrating e-steps"
  M98 P"0:/macros/meltingplot/calibrate_e_steps"
  var esteps_result = global.result   ; global.result is only valid right after the call

  var current_tool = 0
  var current_filament = move.extruders[var.current_tool].filament

  ; NLE calibration is nozzle-specific; the unsuffixed file of profiles predating the
  ; per-nozzle split still counts as calibrated (tpost0.g falls back to it as well)
  var nle = "0:/filaments/" ^ var.current_filament ^ "/config-auto-nle"
  ; sformat.g returns the key in global.result - read it straight away
  M98 P"0:/sys/meltingplot/sformat.g" F{global.nozzle_diameter[var.current_tool]} D2 W0
  var nleSuffix = "-" ^ global.result ^ ".g"
  if var.esteps_result == 0 && !fileexists(var.nle ^ var.nleSuffix) && !fileexists(var.nle ^ ".g")
    echo "No non linear extrusion (NLE) calibration found!"
    if job.file.fileName == null
      echo "Creating NLE calibration."
      M98 P"0:/macros/meltingplot/calibrate_nle"
    else
      echo "Warning: unable to create NLE calibration while printjob is running! Manually run the calibrate_nle macro."

G1 E-12.5 F180      ; retract filament
M400
G4 P0               ; wait for moves to finish

if global.filament_loading_error
  M568 P{var.tool} A0 ; disable heater of tool

M98 P"0:/sys/meltingplot/nozzle-cleaner/clean.g"

M291 P"Clean the printbed" S2

M400 ; sbc specific